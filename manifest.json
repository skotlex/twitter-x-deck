{
  "manifest_version": 3,
  "key": "",
  "name": "X Deck",
  "version": "0.0.1",
  "description": "x.com 추천·팔로잉 타임라인을 덱 형태로 실시간 스트리밍한다.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "nativeMessaging"
  ],
  "host_permissions": ["https://x.com/*", "https://papago.naver.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "embed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Deck 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["deck.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://papago.naver.com/*"],
      "js": ["papago.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
